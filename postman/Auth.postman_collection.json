	"item": [
		{
			"name": "login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Set token as global variable\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.globals.set(\"jwt_token\", jsonData.token);\r",
							"    pm.test(\"Token saved successfully\", function () {\r",
							"        pm.expect(jsonData.token).to.be.a('string');\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"admin\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
